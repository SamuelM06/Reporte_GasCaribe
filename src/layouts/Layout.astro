---
import '../styles/theme.css';

interface Props {
  title: string;
  active: string;
}
const { title, active } = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Cache-Control" content="no-store" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('tema') || 'light';
    </script>
  </head>
  <body>
    <div class="app">
      <header class="topbar">
        <img class="logo" id="logo" src="/logo-azul.svg" alt="Xuma" height="34" />
        <nav>
          <a href="/" class={active === 'inicio' ? 'active' : ''}>Inicio</a>
          <a href="/gestion-diaria" class={active === 'gestion' ? 'active' : ''}>Gestión diaria</a>
          <a href="/abandono" class={active === 'abandono' ? 'active' : ''}>Abandono</a>
        </nav>
        <span class="spacer"></span>
        <button class="theme-btn" id="tema">Claro / Oscuro</button>
      </header>
      <main class="view">
        <slot />
      </main>
    </div>
    <script is:inline>
      const btn = document.getElementById('tema');
      const logo = document.getElementById('logo');
      const apply = () => {
        const t = document.documentElement.dataset.theme;
        if (logo) logo.src = t === 'dark' ? '/logo-blanco.svg' : '/logo-azul.svg';
      };
      btn?.addEventListener('click', () => {
        const t = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
        localStorage.setItem('tema', t);
        apply();
      });
      apply();
    </script>
  </body>
</html>
